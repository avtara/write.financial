# Copy to .env and fill in. Never commit .env.

# Google Cloud project used for Google sign-in and Gmail (D24).
GOOGLE_CLOUD_PROJECT=
# OAuth 2.0 Web client (APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pub/Sub topic for Gmail push, e.g. projects/<project>/topics/gmail-push
GOOGLE_GMAIL_PUBSUB_TOPIC=
