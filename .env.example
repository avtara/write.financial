# Copy to .env and fill in. Never commit .env.
#
# The values below match the local dev stack (`pnpm dev:up`, deploy/dev/compose.yaml).
# Every password/key here is DEV-ONLY: never reuse it on a reachable server.
# Any secret may instead be given as <NAME>_FILE=/path/to/file (Docker secrets);
# setting both <NAME> and <NAME>_FILE is an error. Empty values count as unset.

# selfhost (default) or cloud (D22). cloud additionally requires https PUBLIC_URL,
# SMTP_URL, MAIL_FROM and CMC_API_KEY.
DEPLOYMENT_MODE=selfhost
# development | test | production (default production).
NODE_ENV=development
# URL the browser uses to reach the app.
PUBLIC_URL=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# PostgreSQL 18 (dev stack: 127.0.0.1:5432, superuser postgres / wf-dev-only-postgres).
# One role per process (plan §4.0). `pnpm --filter @wf/db db:bootstrap` creates the roles with the passwords from
# the URLs below (run it once as the superuser), then `pnpm --filter @wf/db db:migrate` creates the tables.
DATABASE_URL=postgres://wf_app:wf-dev-only-app@127.0.0.1:5432/write_financial
DATABASE_URL_WORKER=postgres://wf_worker:wf-dev-only-worker@127.0.0.1:5432/write_financial
# Used only by the auth module (Better Auth); the only role that can read sessions and 2FA secrets.
DATABASE_URL_AUTH=postgres://wf_auth:wf-dev-only-auth@127.0.0.1:5432/write_financial
# Only the migrate process (and KEK rotation, `db:rewrap-keys`) needs this one.
DATABASE_URL_MIGRATE=postgres://wf_migrate:wf-dev-only-migrate@127.0.0.1:5432/write_financial
# Only `db:bootstrap` needs the superuser.
DATABASE_URL_SUPERUSER=postgres://postgres:wf-dev-only-postgres@127.0.0.1:5432/write_financial
# Optional read-only role for operators (statements are logged); without it the role cannot log in.
DATABASE_URL_READONLY_OPS=postgres://wf_readonly_ops:wf-dev-only-readonly-ops@127.0.0.1:5432/write_financial

# Valkey 9 / Redis (dev stack: 127.0.0.1:6379, requirepass wf-dev-only-valkey).
REDIS_URL=redis://:wf-dev-only-valkey@127.0.0.1:6379/0

# S3-compatible object storage (D25; dev stack: SeaweedFS S3 API on 127.0.0.1:8333,
# credentials from deploy/dev/seaweedfs/s3.json). Buckets are created by the dev stack.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=wf-dev-only-access-key
S3_SECRET_ACCESS_KEY=wf-dev-only-secret-key-not-for-production
S3_BUCKET_ATTACHMENTS=wf-attachments
S3_BUCKET_AVATARS=wf-avatars
S3_BUCKET_REPORTS=wf-reports
S3_BUCKET_EXPORTS=wf-exports

# Key-encryption key file (read only by @wf/crypto). `.env.*` files are git-ignored.
KEK_FILE=./.env.kek
# Session/token signing secret, at least 32 characters.
AUTH_SECRET=wf-dev-only-auth-secret-change-me-0123456789
# One-time token for the first-run setup wizard (<PUBLIC_URL>/setup?token=…), at least 22 characters. Optional; the
# self-host init container generates one. DEV-ONLY value.
SETUP_TOKEN=wf-dev-only-setup-token-0123456789

# Outgoing mail (optional in selfhost). Dev stack: Mailpit SMTP 127.0.0.1:1025,
# inbox UI at http://127.0.0.1:8025. MAIL_FROM is required when SMTP_URL is set.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=write.financial (dev) <no-reply@localhost.test>

# Google Cloud project used for Google sign-in and Gmail (D24). Optional; sign-in needs
# the client ID + secret, Gmail additionally needs the project and the Pub/Sub topic.
GOOGLE_CLOUD_PROJECT=
# OAuth 2.0 Web client (APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pub/Sub topic for Gmail push, e.g. projects/<project>/topics/gmail-push
GOOGLE_GMAIL_PUBSUB_TOPIC=

# CoinMarketCap Basic operator key for built-in crypto prices (D23). Optional in selfhost.
CMC_API_KEY=

# Optional custom OpenAI-compatible AI endpoints. Comma-separated exact base URLs, INCLUDING their API path.
# Empty disables Custom; built-in OpenRouter and ZenMux remain available. Never put an API key here.
# Cloud requires HTTPS; selfhost can explicitly approve a trusted local HTTP endpoint.
# Example for selfhost Ollama: http://127.0.0.1:11434/v1
AI_ALLOWED_BASE_URLS=
