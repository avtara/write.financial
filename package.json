{
  "name": "write-financial",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "prepare": "[ -n \"${CI:-}\" ] || [ \"$(git rev-parse --is-inside-work-tree 2>/dev/null)\" != true ] || git config core.hooksPath .githooks",
    "dev:up": "docker compose -f deploy/dev/compose.yaml up -d --wait",
    "dev:down": "docker compose -f deploy/dev/compose.yaml down",
    "dev:reset": "docker compose -f deploy/dev/compose.yaml down -v",
    "db:seed": "pnpm --filter @wf/db db:seed",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "vitest --project unit --project unit-browser",
    "test:unit": "vitest run --project unit --project unit-browser --coverage",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "pnpm --filter @wf/web build && pnpm --filter @wf/web test:e2e",
    "test:mutation": "stryker run",
    "check:test-files": "node tools/repo-checks/src/cli.ts test-files",
    "check:spdx": "node tools/repo-checks/src/cli.ts spdx",
    "check:i18n": "node packages/i18n/src/check-cli.ts",
    "check:tokens": "node tools/tokens-from-pen/src/cli.ts check",
    "tokens": "node tools/tokens-from-pen/src/cli.ts write",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:spdx && pnpm check:test-files && pnpm check:tokens && pnpm test:unit && pnpm check:i18n"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
