# write.financial self-hosting settings. Copy to .env (chmod 600 .env) and fill in; see docs/self-host/install.md.
# Passwords for the database roles, Valkey, S3, the auth secret and the encryption key (KEK) are NOT set here:
# the init container generates them into the `secrets` volume on first start.

# Image tag: a release version (recommended, e.g. 0.1.0) or latest.
WF_VERSION=latest

# Domain Caddy serves. A real domain gets an automatic Let's Encrypt certificate (its DNS must point to this server and
# ports 80/443 must be reachable). `localhost` = local trial with a self-signed certificate.
WF_DOMAIN=localhost
# The URL users open; https://<WF_DOMAIN>.
PUBLIC_URL=https://localhost

# PostgreSQL superuser password, used only by init to create and update the app's database roles. Generate it with
#   openssl rand -base64 32
# It takes effect when the database volume is created; changing it here later does not change it in PostgreSQL.
POSTGRES_PASSWORD=

# selfhost (this compose file) or cloud (the managed write.financial instance, D22).
DEPLOYMENT_MODE=selfhost

# Optional: outgoing mail (verification, password reset). Can also be configured later in the setup wizard.
# MAIL_FROM is required when SMTP_URL is set. Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=

# Optional: Google sign-in with your own Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional restricted Gmail integration; leave ALL three empty until Google verification/security assessment.
GOOGLE_CLOUD_PROJECT=
GOOGLE_GMAIL_PUBSUB_TOPIC=
GOOGLE_GMAIL_PUSH_SERVICE_ACCOUNT=

# Encrypted backups (docs/self-host/backup.md). The age public key (age1…) every backup is encrypted to. Make the key
# pair on another computer with `age-keygen -o write-financial-backup.key` and keep that file off this server: only it
# can decrypt the backups. Without a recipient, `docker compose run --rm backup` refuses to run.
BACKUP_AGE_RECIPIENT=
# Days to keep archives in the backups volume (older ones are deleted after each backup).
BACKUP_RETENTION_DAYS=30
