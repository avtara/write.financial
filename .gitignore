node_modules/
.env
.env.*
!.env.example
dist/
.output/
.turbo/
.DS_Store

# Pencil HTML export (163 MB), regenerated from the design file
design/html/

# Pencil design source is not published (contains a pen.dev fileToken)
*.pen

# Local agent configuration (machine-specific paths)
.omp/

# Test reports
coverage/
/reports/
.stryker-tmp/

# Paraglide output, compiled from packages/i18n/messages by the package's `prepare` script on install
packages/i18n/src/paraglide/
# inlang writes its own cache/metadata next to settings.json
packages/i18n/project.inlang/*
!packages/i18n/project.inlang/settings.json

# Vitest browser-mode failure screenshots
.vitest/
